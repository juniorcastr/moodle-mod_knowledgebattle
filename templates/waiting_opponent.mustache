{{!
    @template mod_knowledgebattle/waiting_opponent

    Displays the waiting screen while searching or waiting for an opponent.

    Example context (json):
    {
        "opponent_name": "Alice"
    }
}}
<div class="knowledgebattle-waiting text-center py-5">
    <div class="spinner-border text-primary mb-4" role="status" style="width: 4rem; height: 4rem;">
        <span class="sr-only">{{#str}}tpl_loading, mod_knowledgebattle{{/str}}</span>
    </div>
    
    <h2 class="mb-3">{{#str}}waiting_opponent, mod_knowledgebattle{{/str}}</h2>
    
    {{#opponent_name}}
        <p class="lead">{{#str}}tpl_challenge_sent_to, mod_knowledgebattle, {{opponent_name}}{{/str}}</p>
        <p class="text-muted">{{#str}}tpl_waiting_accept, mod_knowledgebattle{{/str}}</p>
    {{/opponent_name}}
    {{^opponent_name}}
        <p class="lead">{{#str}}tpl_searching_opponent, mod_knowledgebattle{{/str}}</p>
        <p class="text-muted">{{#str}}tpl_score_recorded, mod_knowledgebattle{{/str}}</p>
    {{/opponent_name}}
    
    <div class="alert alert-info d-inline-block mt-3">
        <i class="fa fa-info-circle"></i> {{#str}}tpl_notify_result, mod_knowledgebattle{{/str}}
    </div>
    
    <div class="mt-5">
        <button class="btn btn-outline-primary" id="btn-back-lobby">{{#str}}tpl_back_to_lobby, mod_knowledgebattle{{/str}}</button>
    </div>
</div>
