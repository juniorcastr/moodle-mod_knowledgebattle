{{!
    @template mod_knowledgebattle/battle_arena

    Battle arena interface for taking a quiz battle.

    Example context (json):
    {
        "current_question": 1,
        "total_questions": 5,
        "time_limit": 15,
        "opponent_name": "AI Master",
        "question": {
            "text": "What is the capital of France?",
            "options": [
                {"index": 0, "letter": "A", "text": "Paris"},
                {"index": 1, "letter": "B", "text": "London"}
            ]
        }
    }
}}
<div class="knowledgebattle-arena">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="m-0">{{#str}}tpl_question_x_of_y, mod_knowledgebattle, {"current":"{{current_question}}","total":"{{total_questions}}"}{{/str}}</h4>
        <div class="timer-badge bg-primary text-white px-3 py-1 rounded-pill h5 m-0">
            <i class="fa fa-clock-o"></i> <span id="time-left">{{time_limit}}</span>s
        </div>
    </div>

    <div class="match-info text-center mb-4 text-muted">
        <strong>{{#str}}tpl_you, mod_knowledgebattle{{/str}}</strong> {{#str}}tpl_vs, mod_knowledgebattle{{/str}} <strong>{{opponent_name}}</strong>
    </div>

    <div class="progress mb-4" style="height: 10px;">
        <div class="progress-bar bg-info" id="battle-progress" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
    </div>

    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h3 class="card-title text-center mb-4" id="question-text">{{question.text}}</h3>
            <div class="row" id="options-container">
                {{#question.options}}
                <div class="col-md-6 mb-3">
                    <button class="btn btn-outline-primary btn-lg w-100 option-btn text-left p-3" data-index="{{index}}" style="white-space: normal;">
                        <span class="font-weight-bold mr-2">{{letter}}.</span> {{text}}
                    </button>
                </div>
                {{/question.options}}
            </div>
            
            <div id="feedback-container" class="mt-4 p-3 rounded d-none">
                <h5 id="feedback-title">{{#str}}feedback, core{{/str}}</h5>
                <p id="feedback-explanation" class="mb-0"></p>
            </div>
        </div>
    </div>

    <div class="text-center">
        <button class="btn btn-primary btn-lg px-5 d-none" id="btn-next-question">
            {{#str}}tpl_next_question, mod_knowledgebattle{{/str}} <i class="fa fa-arrow-right"></i>
        </button>
    </div>
</div>
